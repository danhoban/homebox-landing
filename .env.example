# Homebox connection (internal or external URL, no trailing slash)
HOMEBOX_URL=https://homebox.yourdomain.com
HOMEBOX_USERNAME=your@email.com
HOMEBOX_PASSWORD=yourpassword

# Tag → template mapping. First matching tag wins.
# Each template entry has a FILE (the template to render) and an optional NOTIFY
# (comma-separated Apprise URLs to fire when an item with that tag is scanned).
# See https://github.com/caronc/apprise for all supported notification services.
# Examples:
#   Home Assistant webhook: hasswebhook://YOUR_HA_HOST/YOUR_WEBHOOK_ID
#   Ntfy:                   ntfy://YOUR_NTFY_HOST/TOPIC
#   Pushover:               pover://USER@TOKEN
# Add as many TEMPLATE_N blocks as needed — number them sequentially from 1.
TEMPLATE_DEFAULT=item.html
TEMPLATE_DEFAULT_NOTIFY=hasswebhook://ha.yourdomain.com/your-item-webhook-id
# TEMPLATE_DEFAULT_NOTIFY_TITLE=📦 Lost item found
# TEMPLATE_DEFAULT_NOTIFY_BODY={name} was scanned outside your network

TEMPLATE_1_TAG=Plants
TEMPLATE_1_FILE=plant.html
TEMPLATE_1_NOTIFY=hasswebhook://ha.yourdomain.com/your-plant-webhook-id
# TEMPLATE_1_NOTIFY_TITLE=🌿 Plant scanned
# TEMPLATE_1_NOTIFY_BODY={name} was scanned by a visitor

# Contact details shown on public pages
# Add as many as needed — number them sequentially from 1
# Supported types: email, tel, url
CONTACT_1_TYPE=email
CONTACT_1_LABEL=Email me
CONTACT_1_VALUE=you@example.com

CONTACT_2_TYPE=tel
CONTACT_2_LABEL=Call or text
CONTACT_2_VALUE=+447700900000

# Server bind config (bind to localhost; nginx proxies to this)
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
